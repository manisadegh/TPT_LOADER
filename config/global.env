# ---------------------------------------------------------------------------
# Configuration Globale du Projet
# ---------------------------------------------------------------------------
# Ces variables définissent les noms de base par défaut pour le domaine.
# L'orchestrateur ou le script ajoutera le préfixe d'environnement (TDENV) 
# devant ces noms (ex: TDENV=DEV0 => DEV0SIDMSHSTG).

export SID_ADM_USER="SIDMSHADM"
export DB_STG="SIDMSHSTG"
export DB_WRK="SIDMSHWRK"
